# Image for the release action, built and pushed to the instance registry by
# the images workflow (.forgejo/workflows/images.yml) with the repository
# root as the docker build context (Dockerfile.release).
#
# The action talks to the Forgejo API over HTTPS with net/http, so no CLI
# tools are needed at run time — only the CA bundle.
FROM git.mouse-lake.ts.net/containers/golang:latest AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/action ./release/cmd

FROM git.mouse-lake.ts.net/containers/alpine:latest
RUN apk add --no-cache ca-certificates
COPY --from=build /out/action /bin/action
ENTRYPOINT ["/bin/action"]
