# Image for the package-latest action, built and pushed to the instance registry by
# the images workflow (.forgejo/workflows/images.yml) with the repository
# root as the docker build context (Dockerfile.package-latest).
FROM git.mouse-lake.ts.net/containers/golang:latest AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/action ./package-latest/cmd

FROM git.mouse-lake.ts.net/containers/alpine:latest
RUN apk add --no-cache ca-certificates
COPY --from=build /out/action /bin/action
ENTRYPOINT ["/bin/action"]
