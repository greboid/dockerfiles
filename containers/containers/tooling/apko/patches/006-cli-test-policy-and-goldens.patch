+// checkImagePolicy asserts the containers-repository output policy directly
+// on a built index: every image config must credit Greboid, the apko-written
+// history entries must carry no attribution, and apko-written layers must not
+// embed /etc/apko.json.
+//
+// strict selects scope: with strict=true (from-scratch builds) every history
+// entry and layer is checked; with strict=false (base-image builds) only the
+// final history entry and layer — the ones this build appends — are checked,
+// because a committed base image fixture carries upstream-era metadata that
+// this build does not control.
+func checkImagePolicy(ctx context.Context, idx v1.ImageIndex, strict bool) error {
+	manifest, err := idx.IndexManifest()
+	if err != nil {
+		return err
+	}
+	for _, desc := range manifest.Manifests {
+		img, err := idx.Image(desc.Digest)
+		if err != nil {
+			return fmt.Errorf("image %s: %w", desc.Digest, err)
+		}
+		cfg, err := img.ConfigFile()
+		if err != nil {
+			return fmt.Errorf("config for %s: %w", desc.Digest, err)
+		}
+		if cfg.Author != "Greboid" {
+			return fmt.Errorf("image %s: config author is %q, want Greboid", desc.Digest, cfg.Author)
+		}
+		history := cfg.History
+		if !strict && len(history) > 0 {
+			history = history[len(history)-1:]
+		}
+		for _, h := range history {
+			if h.Author != "" {
+				return fmt.Errorf("image %s: history author %q must be empty (no tool-added attribution)", desc.Digest, h.Author)
+			}
+			if h.CreatedBy != "" {
+				return fmt.Errorf("image %s: history created_by %q must be empty", desc.Digest, h.CreatedBy)
+			}
+			if strings.Contains(h.Comment, "apko") {
+				return fmt.Errorf("image %s: history comment %q carries tool branding", desc.Digest, h.Comment)
+			}
+		}
+		layers, err := img.Layers()
+		if err != nil {
+			return fmt.Errorf("layers for %s: %w", desc.Digest, err)
+		}
+		if !strict && len(layers) > 0 {
+			layers = layers[len(layers)-1:]
+		}
+		for _, layer := range layers {
+			mediaType, err := layer.MediaType()
+			if err != nil {
+				return err
+			}
+			blob, err := layer.Compressed()
+			if err != nil {
+				return err
+			}
+			if err := assertNoEtcApkoJSON(blob, mediaType); err != nil {
+				return fmt.Errorf("image %s: %w", desc.Digest, err)
+			}
+		}
+	}
+	return nil
+}
 
-	require.Equal(t, want, got)
+// assertNoEtcApkoJSON scans a gzipped tar layer for etc/apko.json.
+func assertNoEtcApkoJSON(r io.Reader, mt types1.MediaType) error {
+	if mt != types1.OCILayer && mt != types1.DockerLayer {
+		// Unknown or ER-OFS layer media types are not scanned here; the
+		// standard gzip tar layers are what apko writes for these builds.
+		return nil
+	}
+	gz, err := gzip.NewReader(r)
+	if err != nil {
+		return err
+	}
+	defer gz.Close()
+	tr := tar.NewReader(gz)
+	for {
+		hdr, err := tr.Next()
+		if err == io.EOF {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if strings.TrimPrefix(hdr.Name, "/") == "etc/apko.json" {
+			return fmt.Errorf("layer embeds /etc/apko.json (irrelevant image configuration must be omitted)")
+		}
+	}
 }
