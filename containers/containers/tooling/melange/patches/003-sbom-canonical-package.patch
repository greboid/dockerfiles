+// Package canonical implements RFC 8785 (JSON Canonicalization Scheme) canonical
+// JSON serialization and the deterministic g5d.dev SPDX document namespace
+// scheme used by our patched melange builds (containers repository plan.md).
+//
+// These files are byte-identical (modulo this package clause and doc comment)
+// with tooling/internal/metadata in the containers repository, so verification
+// tooling recomputes exactly the identifiers this package embeds. Update all
+// copies together. Keep the stdlib-only imports: dependencies stay pinned.
+
+package canonical
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode/utf16"
+	"unicode/utf8"
+)
+
+// Canonicalize returns the RFC 8785 (JCS) canonical JSON encoding of v.
+//
+// v is expected to be a generic JSON value as produced by encoding/json
+// unmarshalling into interface{}: map[string]any, []any, string, float64,
+// bool or nil. Canonicalization deliberately does NOT use encoding/json
+// marshalling: RFC 8785 requires ECMAScript number formatting, UTF-16
+// code-unit key ordering and minimal string escaping that encoding/json
+// does not implement (HTML escaping, struct-order keys, different float
+// formatting).
+func Canonicalize(v any) ([]byte, error) {
+	return appendCanonical(nil, v)
+}
+
+// CanonicalizeJSON parses raw JSON and returns its RFC 8785 canonical form.
+// encoding/json is used here only to DECODE the input into the generic value
+// space (map[string]any / []any / string / float64 / bool / nil); the
+// canonical serialization itself is implemented in this file and deliberately
+// differs from what encoding/json would emit.
+func CanonicalizeJSON(raw []byte) ([]byte, error) {
+	var v any
+	if err := json.NewDecoder(bytes.NewReader(raw)).Decode(&v); err != nil {
+		return nil, fmt.Errorf("parsing JSON: %w", err)
+	}
+	return Canonicalize(v)
+}
+
+func appendCanonical(b []byte, v any) ([]byte, error) {
+	switch t := v.(type) {
+	case nil:
+		return append(b, "null"...), nil
+	case bool:
+		if t {
+			return append(b, "true"...), nil
+		}
+		return append(b, "false"...), nil
+	case string:
+		return appendJSONString(b, t), nil
+	case float64:
+		return appendJSONNumber(b, t)
+	case map[string]any:
+		keys := make([]string, 0, len(t))
+		for k := range t {
+			keys = append(keys, k)
+		}
+		sort.Slice(keys, func(i, j int) bool { return lessUTF16(keys[i], keys[j]) })
+		b = append(b, '{')
+		for i, k := range keys {
+			if i > 0 {
+				b = append(b, ',')
+			}
+			b = appendJSONString(b, k)
+			b = append(b, ':')
+			var err error
+			b, err = appendCanonical(b, t[k])
+			if err != nil {
+				return nil, err
+			}
+		}
+		return append(b, '}'), nil
+	case []any:
+		b = append(b, '[')
+		for i, e := range t {
+			if i > 0 {
+				b = append(b, ',')
+			}
+			var err error
+			b, err = appendCanonical(b, e)
+			if err != nil {
+				return nil, err
+			}
+		}
+		return append(b, ']'), nil
+	default:
+		// json.Number or anything else: the canonicalizer only accepts the
+		// generic value space produced by json.Unmarshal into interface{}.
+		return nil, fmt.Errorf("value of type %T is not a canonicalizable JSON value", v)
+	}
+}
+
+// appendJSONString serializes s per RFC 8785 section 3.2.2.2: only the quote,
+// backslash and the C0 control characters are escaped; everything else
+// (including U+007F and non-ASCII characters) is emitted literally as UTF-8.
+func appendJSONString(b []byte, s string) []byte {
+	b = append(b, '"')
+	for i := 0; i < len(s); {
+		c := s[i]
+		if c < utf8.RuneSelf {
+			switch {
+			case c == '"':
+				b = append(b, '\\', '"')
+			case c == '\\':
+				b = append(b, '\\', '\\')
+			case c == '\b':
+				b = append(b, '\\', 'b')
+			case c == '\f':
+				b = append(b, '\\', 'f')
+			case c == '\n':
+				b = append(b, '\\', 'n')
+			case c == '\r':
+				b = append(b, '\\', 'r')
+			case c == '\t':
+				b = append(b, '\\', 't')
+			case c < 0x20:
+				const hex = "0123456789abcdef"
+				b = append(b, '\\', 'u', '0', '0', hex[c>>4], hex[c&0xF])
+			default:
+				b = append(b, c)
+			}
+			i++
+			continue
+		}
+		r, size := utf8.DecodeRuneInString(s[i:])
+		if r == utf8.RuneError && size == 1 {
+			// Invalid UTF-8 cannot occur in strings decoded from JSON
+			// (encoding/json replaces invalid bytes with U+FFFD), but
+			// refuse to emit it rather than corrupt the canonical form.
+			r = '\uFFFD'
+		}
+		b = append(b, s[i:i+size]...)
+		i += size
+	}
+	return append(b, '"')
+}
+
+// appendJSONNumber serializes f per RFC 8785 section 3.2.2.3: ECMAScript
+// Number::toString for doubles, i.e. plain decimal notation within the
+// ECMAScript exponent thresholds and shortest round-trip digits.
+func appendJSONNumber(b []byte, f float64) ([]byte, error) {
+	if math.IsNaN(f) || math.IsInf(f, 0) {
+		return nil, fmt.Errorf("cannot canonicalize non-finite number %v", f)
+	}
+	if f == 0 {
+		return append(b, '0'), nil // also maps -0 to "0"
+	}
+	if f < 0 {
+		b = append(b, '-')
+		f = -f
+	}
+	// strconv with precision -1 yields the shortest decimal digit string
+	// that round-trips to f, in exponential form "d[.dd…]e±XX".
+	s := strconv.FormatFloat(f, 'e', -1, 64)
+	e := strings.IndexByte(s, 'e')
+	if e < 0 {
+		return nil, fmt.Errorf("unexpected FormatFloat output %q", s)
+	}
+	exp, err := strconv.Atoi(s[e+1:])
+	if err != nil {
+		return nil, fmt.Errorf("unexpected FormatFloat exponent in %q", s)
+	}
+	digits := strings.ReplaceAll(s[:e], ".", "")
+	n := exp + 1 // value == 0.digits… × 10^n
+	k := len(digits)
+	switch {
+	case k <= n && n <= 21:
+		b = append(b, digits...)
+		b = appendZeros(b, n-k)
+	case 0 < n && n <= 21:
+		b = append(b, digits[:n]...)
+		b = append(b, '.')
+		b = append(b, digits[n:]...)
+	case -6 < n && n <= 0:
+		b = append(b, "0."...)
+		b = appendZeros(b, -n)
+		b = append(b, digits...)
+	default:
+		b = append(b, digits[0])
+		if k > 1 {
+			b = append(b, '.')
+			b = append(b, digits[1:]...)
+		}
+		b = append(b, 'e')
+		e10 := n - 1
+		if e10 >= 0 {
+			b = append(b, '+')
+		} else {
+			b = append(b, '-')
+			e10 = -e10
+		}
+		b = strconv.AppendInt(b, int64(e10), 10)
+	}
+	return b, nil
+}
+
+func appendZeros(b []byte, n int) []byte {
+	for i := 0; i < n; i++ {
+		b = append(b, '0')
+	}
+	return b
+}
+
+// lessUTF16 orders two strings by their UTF-16 code unit sequences, per
+// RFC 8785 section 3.2.3 (the order ECMAScript sort semantics require, which
+// differs from Go string order for characters above the basic multilingual
+// plane versus supplementary characters).
+func lessUTF16(a, b string) bool {
+	ua := utf16.Encode([]rune(a))
+	ub := utf16.Encode([]rune(b))
+	for i := 0; i < len(ua) && i < len(ub); i++ {
+		if ua[i] != ub[i] {
+			return ua[i] < ub[i]
+		}
+	}
+	return len(ua) < len(ub)
+}
