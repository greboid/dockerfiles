+package canonical
+
+import (
+	"math"
+	"strconv"
+	"testing"
+)
+
+// The vectors below are the official RFC 8785 test data (RFC 8785 section
+// 3.2.3 examples and Appendix B, from the test corpus maintained with the
+// RFC's reference implementations), embedded verbatim so the canonicalizer
+// is anchored to the specification rather than to its own output.
+
+func TestCanonicalizeRFCVectors(t *testing.T) {
+	cases := []struct {
+		name string
+		in   string
+		want string
+	}{
+		{
+			// RFC 8785 section 3.2.2.2/3.2.3 sample with scrambled input
+			// key order; expected canonical output quoted in the RFC.
+			name: "rfc-values-numbers-strings-literals",
+			in:   `{"numbers":[333333333.33333329,1E30,4.50,2e-3,0.000000000000000000000000001],"string":"€$\u000f\nA'B\"\\\\\"/","literals":[null,true,false]}`,
+			want: `{"literals":[null,true,false],"numbers":[333333333.3333333,1e+30,4.5,0.002,1e-27],"string":"€$\u000f\nA'B\"\\\\\"/"}`,
+		},
+		{
+			name: "rfc-arrays",
+			in:   "[56,{\"d\":true,\"10\":null,\"1\":[]}]",
+			want: `[56,{"1":[],"10":null,"d":true}]`,
+		},
+		{
+			// RFC 8785 section 3.2.3 property-ordering sample: control
+			// characters sort first, then ASCII, then BMP characters by
+			// UTF-16 code unit, then the surrogate pair for the smiley.
+			// The output contains raw (unescaped) U+0080 and U+007F bytes.
+			name: "rfc-weird-key-ordering-and-escapes",
+			in:   "{\"\u20ac\":\"Euro Sign\",\"\\r\":\"Carriage Return\",\"\\u000a\":\"Newline\",\"1\":\"One\",\"\\u0080\":\"Control\u007f\",\"\\ud83d\\ude02\":\"Smiley\",\"\\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\\ufb33\":\"Hebrew Letter Dalet With Dagesh\",\"</script>\":\"Browser Challenge\"}",
+			want: "{\"\\n\":\"Newline\",\"\\r\":\"Carriage Return\",\"1\":\"One\",\"</script>\":\"Browser Challenge\",\"\u0080\":\"Control\u007f\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\u20ac\":\"Euro Sign\",\"\U0001F602\":\"Smiley\",\"\uFB33\":\"Hebrew Letter Dalet With Dagesh\"}",
+		},
+		{
+			// Canonicalization must not normalize (e.g. NFC-combine) the
+			// input string; combining marks pass through unchanged.
+			name: "rfc-unnormalized-unicode",
+			in:   "{\"Unnormalized Unicode\":\"A\u030a\"}",
+			want: "{\"Unnormalized Unicode\":\"A\u030a\"}",
+		},
+		{
+			// Sorting ignores locale collation: "péché"/"pêche" sort by raw
+			// code units, not French dictionary order.
+			name: "rfc-french-locale-independent-sorting",
+			in:   "{\"peach\":\"This sorting order\",\"péché\":\"is wrong according to French\",\"pêche\":\"but canonicalization MUST\",\"sin\":\"ignore locale\"}",
+			want: "{\"peach\":\"This sorting order\",\"péché\":\"is wrong according to French\",\"pêche\":\"but canonicalization MUST\",\"sin\":\"ignore locale\"}",
+		},
+		{
+			name: "rfc-structures",
+			in:   `{"1":{"f":{"f":"hi","F":5},"\n":56.0},"10":{},"":"empty","a":{},"111":[{"e":"yes","E":"no"}],"A":{}}`,
+			want: `{"":"empty","1":{"\n":56,"f":{"F":5,"f":"hi"}},"10":{},"111":[{"E":"no","e":"yes"}],"A":{},"a":{}}`,
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := CanonicalizeJSON([]byte(tc.in))
+			if err != nil {
+				t.Fatalf("CanonicalizeJSON: %v", err)
+			}
+			if string(got) != tc.want {
+				t.Fatalf("canonical form mismatch:\n got: %q\nwant: %q", got, tc.want)
+			}
+		})
+	}
+}
+
+// TestAppendNumberRFC8785AppendixB checks the ECMAScript number
+// serialization table from RFC 8785 Appendix B, keyed by the IEEE 754
+// bit patterns given there.
+func TestAppendNumberRFC8785AppendixB(t *testing.T) {
+	cases := []struct{ hexbits, want string }{
+		{"0000000000000000", "0"},
+		{"8000000000000000", "0"}, // minus zero serializes as "0"
+		{"0000000000000001", "5e-324"},
+		{"8000000000000001", "-5e-324"},
+		{"7fefffffffffffff", "1.7976931348623157e+308"},
+		{"ffefffffffffffff", "-1.7976931348623157e+308"},
+		{"4340000000000000", "9007199254740992"},
+		{"c340000000000000", "-9007199254740992"},
+		{"4430000000000000", "295147905179352830000"},
+		{"44b52d02c7e14af5", "9.999999999999997e+22"},
+		{"44b52d02c7e14af6", "1e+23"},
+		{"44b52d02c7e14af7", "1.0000000000000001e+23"},
+		{"444b1ae4d6e2ef4e", "999999999999999700000"},
+		{"444b1ae4d6e2ef4f", "999999999999999900000"},
+		{"444b1ae4d6e2ef50", "1e+21"},
+		{"3eb0c6f7a0b5ed8c", "9.999999999999997e-7"},
+		{"3eb0c6f7a0b5ed8d", "0.000001"},
+		{"41b3de4355555553", "333333333.3333332"},
+		{"41b3de4355555554", "333333333.33333325"},
+		{"41b3de4355555555", "333333333.3333333"},
+		{"41b3de4355555556", "333333333.3333334"},
+		{"41b3de4355555557", "333333333.33333343"},
+		{"becbf647612f3696", "-0.0000033333333333333333"},
+		{"43143ff3c1cb0959", "1424953923781206.2"}, // exactly ...06.25, rounds to even per RFC note 4
+	}
+	for _, tc := range cases {
+		t.Run(tc.hexbits, func(t *testing.T) {
+			bits, err := strconv.ParseUint(tc.hexbits, 16, 64)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err := appendJSONNumber(nil, math.Float64frombits(bits))
+			if err != nil {
+				t.Fatalf("appendJSONNumber: %v", err)
+			}
+			if string(got) != tc.want {
+				t.Fatalf("got %s, want %s", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestCanonicalizeRejectsNonFinite(t *testing.T) {
+	for _, f := range []float64{math.NaN(), math.Inf(1), math.Inf(-1)} {
+		if _, err := Canonicalize(map[string]any{"x": f}); err == nil {
+			t.Fatalf("non-finite value %v accepted", f)
+		}
+	}
+}
+
+func TestLessUTF16(t *testing.T) {
+	less := []struct{ a, b string }{
+		{"", "a"},
+		{"a", "aa"},
+		{"aa", "ab"},
+		{"a", "€"},
+		// Astral-plane characters encode as surrogate pairs starting with
+		// 0xD800..0xDBFF, so they sort below supplementary BMP characters
+		// U+E000..U+FFFF even though their code points are higher. This is
+		// where UTF-16 code-unit ordering differs from Go string ordering.
+		{"\U0001F600", "\uE000"},
+		{"\U0001F600", "\uFFFD"},
+	}
+	for _, c := range less {
+		if !lessUTF16(c.a, c.b) {
+			t.Errorf("lessUTF16(%q, %q) = false, want true", c.a, c.b)
+		}
+		if lessUTF16(c.b, c.a) {
+			t.Errorf("lessUTF16(%q, %q) = true, want false (strict order)", c.b, c.a)
+		}
+	}
+}
