+package canonical
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func mustDoc(t *testing.T, raw string) map[string]any {
+	t.Helper()
+	var doc map[string]any
+	if err := json.Unmarshal([]byte(raw), &doc); err != nil {
+		t.Fatalf("fixture is not valid JSON: %v", err)
+	}
+	return doc
+}
+
+const sampleSPDX = `{
+  "SPDXID": "SPDXRef-DOCUMENT",
+  "name": "apk-miniflux-2.1.4-r0",
+  "spdxVersion": "SPDX-2.3",
+  "creationInfo": {
+    "created": "1970-01-01T00:00:01Z",
+    "creators": ["Tool: melange (v0.61.1)", "Organization: Greboid"],
+    "licenseListVersion": "3.22"
+  },
+  "dataLicense": "CC0-1.0",
+  "documentDescribes": ["SPDXRef-Package-apk-miniflux-2.1.4-r0"],
+  "packages": [
+    {"SPDXID": "SPDXRef-Package-apk-miniflux-2.1.4-r0", "name": "miniflux", "filesAnalyzed": false},
+    {"SPDXRef-OperatingSystem-ID": "x", "SPDXID": "SPDXRef-OperatingSystem", "name": "alpine", "filesAnalyzed": false}
+  ],
+  "relationships": [
+    {"relationshipType": "CONTAINS", "spdxElementId": "SPDXRef-DOCUMENT", "relatedSpdxElement": "SPDXRef-Package-apk-miniflux-2.1.4-r0"}
+  ]
+}`
+
+func TestNamespaceStableForIdenticalDocs(t *testing.T) {
+	id1, err := SPDXUniqueID(mustDoc(t, sampleSPDX))
+	if err != nil {
+		t.Fatalf("SPDXUniqueID: %v", err)
+	}
+	// Re-parse the same document and add whitespace: identity must not change.
+	id2, err := SPDXUniqueID(mustDoc(t, sampleSPDX))
+	if err != nil {
+		t.Fatalf("SPDXUniqueID: %v", err)
+	}
+	if id1 != id2 {
+		t.Fatalf("identical documents produced different ids: %s vs %s", id1, id2)
+	}
+	if len(id1) != 64 {
+		t.Fatalf("unique id %q is not 64 hex chars", id1)
+	}
+}
+
+func TestNamespaceArrayOrderIsPartOfIdentity(t *testing.T) {
+	// RFC 8785 preserves array element order and the plan hashes the emitted
+	// document as-is: two documents whose arrays are ordered differently are
+	// different emitted documents and MUST NOT share an identity. (Emission
+	// itself is responsible for deterministic ordering — e.g. melange sorts
+	// hasExtractedLicensingInfos before emitting and hashing.)
+	swapped := mustDoc(t, sampleSPDX)
+	creators := swapped["creationInfo"].(map[string]any)["creators"].([]any)
+	creators[0], creators[1] = creators[1], creators[0]
+	id1, err := SPDXUniqueID(mustDoc(t, sampleSPDX))
+	if err != nil {
+		t.Fatal(err)
+	}
+	id2, err := SPDXUniqueID(swapped)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id1 == id2 {
+		t.Fatalf("documents differing in array order shared identity %s", id1)
+	}
+}
