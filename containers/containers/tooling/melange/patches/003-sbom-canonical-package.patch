+func TestNamespaceChangesWithContent(t *testing.T) {
+	base, err := SPDXUniqueID(mustDoc(t, sampleSPDX))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, mutate := range map[string]func(map[string]any){
+		"version": func(d map[string]any) {
+			d["name"] = "apk-miniflux-2.1.5-r0"
+		},
+		"arch": func(d map[string]any) {
+			pkgs := d["packages"].([]any)
+			pkgs[0].(map[string]any)["name"] = "miniflux-arm64"
+		},
+		"creator": func(d map[string]any) {
+			ci := d["creationInfo"].(map[string]any)
+			ci["creators"] = []any{"Tool: melange (v0.62.0)", "Organization: Greboid"}
+		},
+		"timestamp": func(d map[string]any) {
+			ci := d["creationInfo"].(map[string]any)
+			ci["created"] = "2030-01-01T00:00:00Z"
+		},
+		"package": func(d map[string]any) {
+			pkgs := d["packages"].([]any)
+			pkgs = append(pkgs, map[string]any{"SPDXID": "SPDXRef-Extra", "name": "extra", "filesAnalyzed": false})
+			d["packages"] = pkgs
+		},
+	} {
+		mutated := mustDoc(t, sampleSPDX)
+		mutate(mutated)
+		id, err := SPDXUniqueID(mutated)
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		if id == base {
+			t.Fatalf("%s: changed document kept identity %s", name, id)
+		}
+	}
+}
+
+func TestNamespaceOmittedFieldAndInputUntouched(t *testing.T) {
+	doc := mustDoc(t, sampleSPDX)
+	doc["documentNamespace"] = NamespacePackages + "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+	before := doc["documentNamespace"]
+	id, err := SPDXUniqueID(doc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if doc["documentNamespace"] != before {
+		t.Fatal("input map was modified")
+	}
+	// Removing the namespace before hashing must yield the same id.
+	without := mustDoc(t, sampleSPDX)
+	delete(without, "documentNamespace")
+	id2, err := SPDXUniqueID(without)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id != id2 {
+		t.Fatalf("explicit namespace key must be omitted from the hash: %s vs %s", id, id2)
+	}
+}
+
+func TestNamespacePrefixAndNoFragment(t *testing.T) {
+	doc := mustDoc(t, sampleSPDX)
+	ns, err := SPDXDocumentNamespace(doc, NamespacePackages)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ns) <= len(NamespacePackages) || ns[:len(NamespacePackages)] != NamespacePackages {
+		t.Fatalf("namespace %q lacks packages prefix", ns)
+	}
+	for _, r := range ns {
+		if r == '#' {
+			t.Fatalf("namespace %q contains a fragment", ns)
+		}
+	}
+}
+
+func TestNamespacePreservesExplicitNulls(t *testing.T) {
+	// RFC 8785 preserves null; only documentNamespace is omitted from the
+	// hash. A document with an explicit null set-like array and one with the
+	// field absent are distinct emitted documents and must not share an
+	// identity.
+	withNull := mustDoc(t, sampleSPDX)
+	withNull["documentDescribes"] = nil
+	without := mustDoc(t, sampleSPDX)
+	delete(without, "documentDescribes")
+	id1, err := SPDXUniqueID(withNull)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id2, err := SPDXUniqueID(without)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id1 == id2 {
+		t.Fatalf("null and absent documentDescribes must hash differently: %s", id1)
+	}
+}
