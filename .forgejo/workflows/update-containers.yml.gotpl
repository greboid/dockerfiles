on:
  workflow_dispatch:
  schedule:
    - cron: '42 12 * * *'
  workflow_call:
name: Update Containers
concurrency: dockerfiles
jobs:
{%- for target in targets %}
  {{ target.name }}:
    name: Build {{ target.name }}{% if target.needed.size > 0 %}
    needs:
{%- for dep in target.needed %}
        - {{ dep -}}
{%- endfor -%}
{% endif %}
    uses: ./.forgejo/workflows/container-builder.yml
    secrets: inherit
    with:
        PROJECT_NAME: {{ target.name }}
{% endfor %}
