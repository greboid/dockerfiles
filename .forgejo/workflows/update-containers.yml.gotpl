on:
  workflow_dispatch:
  schedule:
    - cron: '42 12 * * *'
  workflow_call:
name: Update Containers
concurrency: dockerfiles
enable-openid-connect: true
jobs:
{%- for target in targets %}
  {{ target.name }}:
    name: Build {{ target.name }}{% if target.needed.size > 0 %}
    needs:
{%- for dep in target.needed %}
        - {{ dep -}}
{%- endfor -%}
{% endif %}
    runs-on: alpine
    env:
      PROJECT_NAME: {{ target.name }}{% raw %}
      REGISTRY: ${{ secrets.REGISTRY }}
      GIT_USERNAME: ${{ secrets.GIT_USERNAME }}
      GIT_EMAIL: ${{ secrets.GIT_EMAIL }}
      CONTEMPT_TOKEN: ${{ secrets.CONTEMPT_TOKEN }}
      REPOSITORY: ${{ github.repository }}
      ACTOR: ${{ github.actor }}
    steps:
      - name: Checkout source
        uses: actions/toolkit/git-checkout@master
        with:
          fetch-depth: '0'
      - name: Setup Go
        uses: actions/toolkit/go-setup@master
        with:
          go-version: 'stable'
      - name: Install latest contempt
        run: |
          go install github.com/csmith/contempt/cmd/contempt@latest
          echo "$(go env GOPATH)/bin" >> "$GITHUB_PATH"
      - name: Login to private registry
        uses: actions/toolkit/docker-login@master
        with:
          registry: ${{ secrets.REGISTRY }}
          username: ${{ secrets.REGISTRY_USER }}
          password: ${{ secrets.REGISTRY_PASS }}
      - name: Configure Git
        run: |
          command -v git >/dev/null 2>&1 || apk add --no-cache git
          git config user.name "$GIT_USERNAME"
          git config user.email "$GIT_EMAIL"
      - name: Update
        env:
          BUILDAH_ISOLATION: chroot
          SOURCE_LINK: https://git.mouse-lake.ts.net/greboid/dockerfiles/blob/master/
        run: contempt -template Containerfile.gotpl -output Containerfile --commit --build --push --project "$PROJECT_NAME" . .
      - name: Check mirror
        id: check_mirror
        run: |
          if [ -f "$PROJECT_NAME/MIRROR" ]; then
            if [ -n "$CONTEMPT_TOKEN" ]; then
              echo "files_exists=true" >> "$GITHUB_OUTPUT"
            else
              echo "::warning::CONTEMPT_TOKEN secret is not set — skipping ghcr.io mirror for $PROJECT_NAME"
            fi
          fi
      - name: Mirror the image
        if: steps.check_mirror.outputs.files_exists == 'true'
        run: |
          buildah login -u "$ACTOR" -p "$CONTEMPT_TOKEN" ghcr.io
          buildah tag "$REGISTRY/$PROJECT_NAME" "ghcr.io/$REPOSITORY/$PROJECT_NAME"
          buildah push "ghcr.io/$REPOSITORY/$PROJECT_NAME"
      - name: Push changes
        uses: actions/toolkit/git-try-push@master
        with:
          audience: u:1:5759a8a9-9323-4319-9847-028d8698373f
{% endraw %}{% endfor %}
