+// head405Server is a Forgejo-shaped Alpine endpoint: HEAD on the index is not
+// implemented (405 Method Not Allowed, allow: GET, DELETE — exactly what
+// https://git.mouse-lake.ts.net/api/packages/containers/alpine/gate5/...
+// serves), while GET returns the index body. Request counts are recorded so
+// tests can assert which methods actually reached the wire.
+type head405Server struct {
+	srv       *httptest.Server
+	head      atomic.Int64
+	get       atomic.Int64
+	status    int // status served for HEAD
+	getStatus int // status served for GET (default 200)
+	body      []byte
+	etag      string // optional ETag served on GET
+	user      string // optional basic auth required on GET
+	pass      string
+}
+
+func newHead405Server(t *testing.T, status int, body []byte) *head405Server {
+	t.Helper()
+	h := &head405Server{status: status, getStatus: http.StatusOK, body: body}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodHead {
+			h.head.Add(1)
+			w.Header().Set("Allow", "GET, DELETE")
+			w.WriteHeader(h.status)
+			return
+		}
+		if r.Method != http.MethodGet {
+			w.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		h.get.Add(1)
+		if h.getStatus != http.StatusOK {
+			w.WriteHeader(h.getStatus)
+			return
+		}
+		if h.user != "" {
+			u, p, ok := r.BasicAuth()
+			if !ok || u != h.user || p != h.pass {
+				w.WriteHeader(http.StatusUnauthorized)
+				return
+			}
+		}
+		if h.etag != "" {
+			w.Header().Set("Etag", h.etag)
+		}
+		_, _ = w.Write(h.body)
+	})
+	h.srv = httptest.NewServer(mux)
+	t.Cleanup(h.srv.Close)
+	return h
+}
+
+func testIndexBody(t *testing.T) []byte {
+	t.Helper()
+	idx := &APKIndex{Description: "head-405-fallback-test"}
+	idx.Packages = append(idx.Packages, &Package{
+		Name:     "gate5-fixture",
+		Version:  "0.0.1-r0",
+		Arch:     "x86_64",
+		Checksum: []byte("01234567890123456789"),
+	})
+	archive, err := ArchiveFromIndex(idx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := io.ReadAll(archive)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+// TestIndexHead405FallsBackToGET pins the Forgejo compatibility behavior of
+// the index path: when the etag-probe HEAD is answered 405 or 501, the index
+// is still fetched via the ordinary GET path (same auth, same signature
+// verification, same size bounds). Any other non-200 status must keep failing.
+func TestIndexHead405FallsBackToGET(t *testing.T) {
+	for _, status := range []int{http.StatusMethodNotAllowed, http.StatusNotImplemented} {
+		t.Run(fmt.Sprintf("HEAD-%d", status), func(t *testing.T) {
+			h := newHead405Server(t, status, testIndexBody(t))
+
+			indexes, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL}, nil, "x86_64",
+				WithIgnoreSignatures(true), WithHTTPClient(h.srv.Client()))
+			if err != nil {
+				t.Fatalf("expected HEAD %d to fall back to GET, got error: %v", status, err)
+			}
+			if len(indexes) != 1 {
+				t.Fatalf("got %d indexes, want 1", len(indexes))
+			}
+			pkgs := indexes[0].Packages()
+			if len(pkgs) != 1 || pkgs[0].Name != "gate5-fixture" {
+				t.Errorf("unexpected packages: %+v", pkgs)
+			}
+			if got := h.head.Load(); got != 1 {
+				t.Errorf("HEAD request count = %d, want 1", got)
+			}
+			if got := h.get.Load(); got != 1 {
+				t.Errorf("GET request count = %d, want 1", got)
+			}
+		})
+	}
+}
+
+func TestIndexHeadOtherStatusesStillFail(t *testing.T) {
+	for _, status := range []int{http.StatusNotFound, http.StatusForbidden, http.StatusInternalServerError} {
+		t.Run(fmt.Sprintf("HEAD-%d", status), func(t *testing.T) {
+			h := newHead405Server(t, status, testIndexBody(t))
+
+			_, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL}, nil, "x86_64",
+				WithIgnoreSignatures(true), WithHTTPClient(h.srv.Client()))
+			if err == nil {
+				t.Fatalf("HEAD %d must remain a hard error", status)
+			}
+			if !strings.Contains(err.Error(), fmt.Sprintf("unexpected status code %d", status)) {
+				t.Errorf("error = %v, want unexpected status code %d", err, status)
+			}
+		})
+	}
+}
