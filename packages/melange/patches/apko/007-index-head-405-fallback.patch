+// TestIndexHead405FallbackPreservesAuth proves the fallback GET carries the
+// configured authenticator's credentials, and that missing credentials still
+// fail (the fallback must not become an auth bypass).
+func TestIndexHead405FallbackPreservesAuth(t *testing.T) {
+	h := newHead405Server(t, http.StatusMethodNotAllowed, testIndexBody(t))
+	h.user, h.pass = "user", "pass"
+	host := strings.TrimPrefix(h.srv.URL, "http://")
+
+	t.Run("authenticated", func(t *testing.T) {
+		indexes, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL}, nil, "x86_64",
+			WithIgnoreSignatures(true),
+			WithHTTPClient(h.srv.Client()),
+			WithIndexAuthenticator(auth.StaticAuth(host, "user", "pass")))
+		if err != nil {
+			t.Fatalf("authenticated fallback GET failed: %v", err)
+		}
+		if len(indexes) != 1 {
+			t.Fatalf("got %d indexes, want 1", len(indexes))
+		}
+	})
+
+	t.Run("wrong-credentials-still-fail", func(t *testing.T) {
+		_, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL}, nil, "x86_64",
+			WithIgnoreSignatures(true),
+			WithHTTPClient(h.srv.Client()),
+			WithIndexAuthenticator(auth.StaticAuth(host, "user", "wrong")))
+		if err == nil {
+			t.Fatal("fallback GET with wrong credentials must not succeed")
+		}
+		if !strings.Contains(err.Error(), "unexpected status code 401") {
+			t.Errorf("error = %v, want unexpected status code 401", err)
+		}
+	})
+}
