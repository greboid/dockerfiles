+// TestCacheHead405FallsBackToGETAndCaches covers the cache transport HEAD
+// path: the 405 failure response must not be cached as if it were the etag
+// probe result; instead one authenticated GET discovers the etag, the
+// content-addressed disk cache engages, and no further HEAD reaches the wire
+// on subsequent fetches.
+func TestCacheHead405FallsBackToGETAndCaches(t *testing.T) {
+	h := newHead405Server(t, http.StatusMethodNotAllowed, testIndexBody(t))
+	h.etag = `"gate5-v1"`
+	h.user, h.pass = "user", "pass"
+	host := strings.TrimPrefix(h.srv.URL, "http://")
+
+	c := &cache{dir: t.TempDir(), shared: NewCache(true)}
+	client := c.client(h.srv.Client(), true)
+
+	fetch := func() {
+		t.Helper()
+		indexes, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL}, nil, "x86_64",
+			WithIgnoreSignatures(true),
+			WithHTTPClient(client),
+			WithIndexAuthenticator(auth.StaticAuth(host, "user", "pass")))
+		if err != nil {
+			t.Fatalf("HEAD-405 cache path failed: %v", err)
+		}
+		if len(indexes) != 1 {
+			t.Fatalf("got %d indexes, want 1", len(indexes))
+		}
+	}
+
+	fetch()
+	fetch()
+
+	if got := h.head.Load(); got != 1 {
+		t.Errorf("HEAD request count after two fetches = %d, want 1 (the 405 must be answered once, then cached as HEAD-unsupported)", got)
+	}
+	// One GET for the etag discovery, one GET for the actual index download;
+	// the second fetch must be served entirely from cache.
+	if got := h.get.Load(); got != 2 {
+		t.Errorf("GET request count after two fetches = %d, want 2", got)
+	}
+}
+
+// TestCacheHead405WithoutEtagStillWorks covers HEAD-405 servers that serve no
+// ETag at all: the fetch must succeed via GET (twice), and the cached
+// HEAD-unsupported state must prevent repeated 405 round trips.
+func TestCacheHead405WithoutEtagStillWorks(t *testing.T) {
+	h := newHead405Server(t, http.StatusMethodNotAllowed, testIndexBody(t))
+
+	c := &cache{dir: t.TempDir(), shared: NewCache(true)}
+	client := c.client(h.srv.Client(), true)
+
+	for i := range 2 {
+		if _, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL}, nil, "x86_64",
+			WithIgnoreSignatures(true), WithHTTPClient(client)); err != nil {
+			t.Fatalf("fetch %d failed: %v", i+1, err)
+		}
+	}
+
+	if got := h.head.Load(); got != 1 {
+		t.Errorf("HEAD request count after two fetches = %d, want 1", got)
+	}
+	// Fetch 1: one GET for etag discovery (discarded body) and one passthrough
+	// GET for the content. Fetch 2: only the content GET — the etag-discovery
+	// result (HEAD-unsupported, no etag) is cached, so no second discovery GET
+	// and no repeated 405 HEAD round trip.
+	if got := h.get.Load(); got != 3 {
+		t.Errorf("GET request count after two fetches = %d, want 3", got)
+	}
+}
+
+// TestCacheHead405FailureResponseNotCached pins that a fallback GET which
+// itself fails propagates the error instead of caching a bogus success: the
+// index fetch fails, and failure semantics are identical to the
+// HEAD-supported path.
+func TestCacheHead405FailureResponseNotCached(t *testing.T) {
+	h := newHead405Server(t, http.StatusMethodNotAllowed, testIndexBody(t))
+	h.getStatus = http.StatusNotFound // the content is gone
+
+	c := &cache{dir: t.TempDir(), shared: NewCache(true)}
+	client := c.client(h.srv.Client(), true)
+
+	_, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL}, nil, "x86_64",
+		WithIgnoreSignatures(true), WithHTTPClient(client))
+	if err == nil {
+		t.Fatal("HEAD 405 with failing GET must surface the GET failure")
+	}
+	if !strings.Contains(err.Error(), "unexpected status code 404") {
+		t.Errorf("error = %v, want the GET 404 to be reported", err)
+	}
+}
