+// signedIndexBody builds a real RSA256-signed APKINDEX archive: first gzip
+// member carries the .SIGN.RSA256.<keyName> tar member, second carries the
+// index (this is the layout parseRepositoryIndex expects, with the signature
+// covering the raw second-member bytes).
+func signedIndexBody(t *testing.T, keyName string) (body, publicKey []byte) {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	indexBytes := testIndexBody(t)
+	digest := sha256.Sum256(indexBytes)
+
+	keyPath := filepath.Join(t.TempDir(), "signing.rsa")
+	privPEM := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)})
+	if err := os.WriteFile(keyPath, privPEM, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	sig, err := signature.RSASignDigest(digest[:], crypto.SHA256, keyPath, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var sigTar bytes.Buffer
+	tw := tar.NewWriter(&sigTar)
+	hdr := &tar.Header{Name: fmt.Sprintf(".SIGN.RSA256.%s", keyName), Mode: 0o644, Size: int64(len(sig))}
+	if err := tw.WriteHeader(hdr); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := tw.Write(sig); err != nil {
+		t.Fatal(err)
+	}
+	// apk-tools writes the signature tar member WITHOUT the two end-of-archive
+	// blocks, so the concatenated stream continues seamlessly into the index
+	// member (see the real Alpine APKINDEX layout). Flush pads the entry but
+	// must not be followed by Close.
+	if err := tw.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	var sigMember bytes.Buffer
+	gw := gzip.NewWriter(&sigMember)
+	if _, err := gw.Write(sigTar.Bytes()); err != nil {
+		t.Fatal(err)
+	}
+	if err := gw.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	pub, err := x509.MarshalPKIXPublicKey(&key.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pubPEM := pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: pub})
+
+	return append(sigMember.Bytes(), indexBytes...), pubPEM
+}
+
+// TestIndexHead405FallbackSignatures pins that the fallback GET does not
+// weaken trust: signed content verifies (positive), unsigned content and wrong
+// keys are rejected exactly as on the HEAD-supported path (negative).
+func TestIndexHead405FallbackSignatures(t *testing.T) {
+	keyName := "gate5-test.rsa.pub"
+
+	t.Run("signed-index-verifies", func(t *testing.T) {
+		body, pub := signedIndexBody(t, keyName)
+		h := newHead405Server(t, http.StatusMethodNotAllowed, body)
+
+		indexes, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL},
+			map[string][]byte{keyName: pub}, "x86_64",
+			WithHTTPClient(h.srv.Client()))
+		if err != nil {
+			t.Fatalf("signed index rejected on HEAD-405 fallback: %v", err)
+		}
+		if len(indexes) != 1 || len(indexes[0].Packages()) != 1 {
+			t.Fatalf("unexpected indexes: %+v", indexes)
+		}
+	})
+
+	t.Run("unsigned-index-still-rejected", func(t *testing.T) {
+		h := newHead405Server(t, http.StatusMethodNotAllowed, testIndexBody(t))
+		if _, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL},
+			map[string][]byte{keyName: []byte("irrelevant")}, "x86_64",
+			WithHTTPClient(h.srv.Client())); err == nil {
+			t.Fatal("unsigned index must be rejected on the fallback path")
+		}
+	})
+
+	t.Run("wrong-key-still-rejected", func(t *testing.T) {
+		body, _ := signedIndexBody(t, keyName)
+		other, err := rsa.GenerateKey(rand.Reader, 2048)
+		if err != nil {
+			t.Fatal(err)
+		}
+		pubOther, err := x509.MarshalPKIXPublicKey(&other.PublicKey)
+		if err != nil {
+			t.Fatal(err)
+		}
+		h := newHead405Server(t, http.StatusMethodNotAllowed, body)
+		if _, err := GetRepositoryIndexes(t.Context(), []string{h.srv.URL},
+			map[string][]byte{keyName: pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: pubOther})},
+			"x86_64", WithHTTPClient(h.srv.Client())); err == nil {
+			t.Fatal("index signed by the wrong key must be rejected on the fallback path")
+		}
+	})
+}
