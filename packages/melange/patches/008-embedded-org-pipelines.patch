--- /dev/null
+++ i/pkg/build/pipelines/test/version.yaml
@@ -0,0 +1,35 @@
+name: Check the packaged program reports its version
+
+inputs:
+  executable:
+    description: |
+      Program to run. Defaults to /usr/bin/<package name>.
+    default: ''
+
+  flag:
+    description: |
+      Flag that makes the program print its version. Defaults to --version.
+    default: ''
+
+  pattern:
+    description: |
+      Extended regular expression expected in the version output.
+      Defaults to the package version.
+    default: ''
+
+pipeline:
+  - runs: |
+      exe="${{inputs.executable}}"
+      [ -n "$exe" ] || exe="/usr/bin/${{package.name}}"
+      flag="${{inputs.flag}}"
+      [ -n "$flag" ] || flag="--version"
+      pattern="${{inputs.pattern}}"
+      [ -n "$pattern" ] || pattern="${{package.version}}"
+
+      [ -x "$exe" ] || { echo "test/version: $exe is not executable" >&2; exit 1; }
+      out="$("$exe" $flag 2>&1 || true)"
+      echo "$out" | head -5
+      echo "$out" | grep -qE -- "$pattern" || {
+        echo "test/version: output did not match '$pattern'" >&2
+        exit 1
+      }
