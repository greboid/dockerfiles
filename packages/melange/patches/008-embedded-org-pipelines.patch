+    description: |
+      Directories to create, space- or newline-separated, relative to the
+      root of the package (a leading slash is ignored).
+    required: true
+
+  mode:
+    description: |
+      Mode to apply to the created directories.
+    default: '0755'
+
+pipeline:
+  - runs: |
+      mkdir -p "${{targets.destdir}}"
