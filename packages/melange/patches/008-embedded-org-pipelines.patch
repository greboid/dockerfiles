diff --git c/pkg/build/pipelines/go/credits.yaml i/pkg/build/pipelines/go/credits.yaml
new file mode 100644
index 0000000..d93b515
--- /dev/null
+++ i/pkg/build/pipelines/go/credits.yaml
@@ -0,0 +1,36 @@
+name: Install the Go dependency credits
+
+needs:
+  packages:
+    - gocredits
+
+inputs:
+  directory:
+    description: |
+      Go module directory to credit, relative to the source root.
+    default: .
+
+  skip-missing:
+    description: |
+      Skip, with a warning, dependency modules that ship no license file
+      instead of failing.
+    default: 'false'
+
+pipeline:
+  # Fails when a dependency module ships no license file, unless
+  # skip-missing is set. gocredits walks
+  # the source tree for packages, so the module cache go/build keeps there
+  # is hidden behind a dot-directory while it runs.
+  - runs: |
+      cd "${{inputs.directory}}"
+      cache="$PWD/go-package-cache"
+      hidden="$PWD/.go-package-cache"
+      [ -d "$cache" ] && mv "$cache" "$hidden"
+      mkdir -p "${{targets.destdir}}/usr/share/licenses/${{package.name}}"
+      skip=""
+      [ "${{inputs.skip-missing}}" = "true" ] && skip="-skip-missing"
+      rc=0
+      GOMODCACHE="$hidden" GOTELEMETRY=off gocredits $skip . \
+        > "${{targets.destdir}}/usr/share/licenses/${{package.name}}/CREDITS" || rc=$?
+      [ -d "$hidden" ] && mv "$hidden" "$cache"
+      exit $rc
diff --git c/pkg/build/pipelines/license/install.yaml i/pkg/build/pipelines/license/install.yaml
new file mode 100644
index 0000000..89869fd
--- /dev/null
+++ i/pkg/build/pipelines/license/install.yaml
@@ -0,0 +1,33 @@
+name: Install the package's license files
+
+inputs:
+  license:
+    description: |
+      Path(s) to the license file(s) to install, space-separated. When
+      empty, a license file is looked up in the source root among LICENSE,
+      LICENSE.md, LICENCE, LICENCE.md, COPYING and COPYING.md.
+    default: ''
+
+pipeline:
+  - runs: |
+      lic="${{inputs.license}}"
+      if [ -z "$lic" ]; then
+        for candidate in LICENSE LICENSE.md LICENCE LICENCE.md COPYING COPYING.md; do
+          if [ -f "$candidate" ]; then
+            lic="$candidate"
+            break
+          fi
+        done
+      fi
+      if [ -z "$lic" ]; then
+        echo "license/install: no license file found" >&2
+        exit 1
+      fi
+      for f in $lic; do
+        if [ ! -f "$f" ]; then
+          echo "license/install: no license file found: $f" >&2
+          exit 1
+        fi
+        install -Dm 0644 "$f" \
+          "${{targets.destdir}}/usr/share/licenses/${{package.name}}/$(basename "$f")"
+      done
