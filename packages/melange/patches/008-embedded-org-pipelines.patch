+++ i/pkg/build/pipelines/pnpm/build.yaml
@@ -0,0 +1,22 @@
+name: Build packages of a pnpm workspace.
+
+inputs:
+  working-directory:
+    description: |
+      Directory containing the workspace's root package.json. Defaults to
+      the workspace root. Requires pnpm (installed by pnpm/install).
+    default: "."
+
+  filters:
+    description: |
+      Space-separated pnpm --filter selectors, built sequentially in the
+      order listed so that inter-package build dependencies are
+      respected, e.g. "@immich/sdk immich immich-web".
+    required: true
+
+pipeline:
+  - runs: |
+      cd ${{inputs.working-directory}}
+      for f in ${{inputs.filters}}; do
+        pnpm --filter "$f" build
+      done
diff --git c/pkg/build/pipelines/pnpm/install.yaml i/pkg/build/pipelines/pnpm/install.yaml
new file mode 100644
index 0000000..ec2b6f3
--- /dev/null
+++ i/pkg/build/pipelines/pnpm/install.yaml
@@ -0,0 +1,26 @@
+name: Install the dependencies of a pnpm workspace.
+
+needs:
+  packages:
+    - busybox
+    - nodejs
+    - npm
+
+inputs:
+  working-directory:
+    description: |
+      Directory containing the workspace's root package.json, whose
+      packageManager field pins the pnpm version. Defaults to the
+      workspace root.
+    default: "."
+
+pipeline:
+  - runs: |
+      # corepack isn't packaged for alpine; install it from npm. It reads
+      # the pnpm version pinned in package.json's packageManager field
+      # (e.g. pnpm@11.22.0).
+      cd ${{inputs.working-directory}}
+      npm rm -g corepack >/dev/null 2>&1 || true
+      npm install -g corepack
+      corepack enable
+      pnpm install --frozen-lockfile
