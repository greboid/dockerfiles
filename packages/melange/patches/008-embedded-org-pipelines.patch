new file mode 100644
index 0000000..ee00795
--- /dev/null
+++ i/pkg/build/pipelines/test/paths.yaml
@@ -0,0 +1,51 @@
+name: Check paths in the installed package
+
+inputs:
+  executables:
+    description: |
+      Paths that must exist and be executable, space-separated.
+    default: ''
+
+  files:
+    description: |
+      Paths that must exist as regular files, space-separated.
+    default: ''
+
+  dirs:
+    description: |
+      Paths that must exist as directories, space-separated.
+    default: ''
+
+  nonempty-dirs:
+    description: |
+      Paths that must exist as directories with at least one entry,
+      space-separated.
+    default: ''
+
+  symlinks:
+    description: |
+      Paths that must exist as symbolic links, space-separated.
+    default: ''
+
+pipeline:
+  - runs: |
+      fail=0
+      for p in ${{inputs.executables}}; do
+        [ -x "$p" ] || { echo "test/paths: missing executable: $p" >&2; fail=1; }
+      done
+      for p in ${{inputs.files}}; do
+        [ -f "$p" ] || { echo "test/paths: missing file: $p" >&2; fail=1; }
+      done
+      for p in ${{inputs.dirs}}; do
+        [ -d "$p" ] || { echo "test/paths: missing directory: $p" >&2; fail=1; }
+      done
+      for p in ${{inputs.nonempty-dirs}}; do
+        if [ ! -d "$p" ] || [ -z "$(ls -A "$p" 2>/dev/null)" ]; then
+          echo "test/paths: empty or missing directory: $p" >&2
+          fail=1
+        fi
+      done
+      for p in ${{inputs.symlinks}}; do
+        [ -L "$p" ] || { echo "test/paths: missing symlink: $p" >&2; fail=1; }
+      done
+      exit $fail
diff --git c/pkg/build/pipelines/test/version.yaml i/pkg/build/pipelines/test/version.yaml
new file mode 100644
index 0000000..33d03cb
--- /dev/null
+++ i/pkg/build/pipelines/test/version.yaml
@@ -0,0 +1,35 @@
+name: Check the packaged program reports its version
+
+inputs:
+  executable:
+    description: |
+      Program to run. Defaults to /usr/bin/<package name>.
+    default: ''
+
+  flag:
+    description: |
+      Flag that makes the program print its version. Defaults to --version.
+    default: ''
+
+  pattern:
+    description: |
+      Extended regular expression expected in the version output.
+      Defaults to the package version.
+    default: ''
+
+pipeline:
+  - runs: |
+      exe="${{inputs.executable}}"
+      [ -n "$exe" ] || exe="/usr/bin/${{package.name}}"
+      flag="${{inputs.flag}}"
+      [ -n "$flag" ] || flag="--version"
+      pattern="${{inputs.pattern}}"
+      [ -n "$pattern" ] || pattern="${{package.version}}"
+
+      [ -x "$exe" ] || { echo "test/version: $exe is not executable" >&2; exit 1; }
+      out="$("$exe" $flag 2>&1 || true)"
+      echo "$out" | head -5
+      echo "$out" | grep -qE -- "$pattern" || {
+        echo "test/version: output did not match '$pattern'" >&2
+        exit 1
+      }
diff --git c/pkg/build/pipelines/secret-env/wrap.yaml i/pkg/build/pipelines/secret-env/wrap.yaml
new file mode 100644
index 0000000..e6845216dc3573e69a442f78b401c32af25c2416
--- /dev/null
+++ i/pkg/build/pipelines/secret-env/wrap.yaml
@@ -0,0 +1,28 @@
+name: Opt-in native-name wrapper for a binary owned by this package
+
+inputs:
+  name:
+    required: true
+    description: Existing executable basename in usr/bin
+  config:
+    required: true
+    description: Source config selecting /usr/libexec/NAME.real
+
+pipeline:
+  - runs: |
+      name='${{inputs.name}}'
+      case "$name" in
+        ''|secret-env|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) echo 'invalid wrapper name' >&2; exit 1 ;;
+      esac
+      test "${#name}" -le 128
+      root='${{targets.contextdir}}'
+      test -f "$root/usr/bin/$name"
+      test ! -L "$root/usr/bin/$name"
+      test ! -e "$root/usr/libexec/$name.real"
+      test ! -L "$root/usr/libexec/$name.real"
+      test ! -e "$root/etc/secret-env/$name.conf"
+      test ! -L "$root/etc/secret-env/$name.conf"
+      mkdir -p "$root/usr/libexec" "$root/etc/secret-env"
+      mv "$root/usr/bin/$name" "$root/usr/libexec/$name.real"
+      install -m644 '${{inputs.config}}' "$root/etc/secret-env/$name.conf"
+      ln -s /usr/bin/secret-env "$root/usr/bin/$name"
