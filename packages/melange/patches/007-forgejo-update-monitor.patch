+	require.Equal(t, "https://codeberg.org", cfg.Update.ForgejoMonitor.Instance)
+	require.Equal(t, "myorg/test-update-vars-forgejo", cfg.Update.ForgejoMonitor.Identifier)
+	require.Equal(t, "v1.0.", cfg.Update.ForgejoMonitor.TagFilterPrefix)
+}
