+vars:
+  instance: https://codeberg.org
+  stream: "1.0"
+
+update:
+  enabled: true
+  forgejo:
+    instance: ${{vars.instance}}
+    identifier: myorg/${{package.name}}
+    tag-filter-prefix: v${{vars.stream}}.
