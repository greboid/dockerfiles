+// findReuseLicenses reads the license texts of a REUSE-style LICENSES
+// directory, used by modules with no license file at their root.
+func findReuseLicenses(dir string) (string, string, error) {
+	files, err := os.ReadDir(filepath.Join(dir, "LICENSES"))
+	if err != nil {
+		return "", "", err
+	}
+	var texts []string
+	for _, f := range files {
+		if f.IsDir() {
+			continue
+		}
+		bs, err := os.ReadFile(filepath.Join(dir, "LICENSES", f.Name()))
+		if err != nil {
+			return "", "", err
+		}
+		texts = append(texts, string(bs))
+	}
+	if len(texts) == 0 {
+		return "", "", os.ErrNotExist
+	}
+	return "LICENSES", strings.Join(texts, "\n"), nil
+}
