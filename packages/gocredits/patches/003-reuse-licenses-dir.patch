+package gocredits
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestFindLicenseReuseDir(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dir, "LICENSES"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for name, content := range map[string]string{"Apache-2.0.txt": "apache\n", "MIT.txt": "mit\n"} {
+		if err := os.WriteFile(filepath.Join(dir, "LICENSES", name), []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	name, content, err := findLicense(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if name != "LICENSES" || content != "apache\n\nmit\n" {
+		t.Fatalf("got %q %q", name, content)
+	}
+}
