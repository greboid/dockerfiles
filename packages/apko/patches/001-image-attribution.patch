@@ -51,8 +51,10 @@ func BuildImageFromLayers(ctx context.Context, baseImage v1.Image, layers []v1.L
 		return nil, err
 	}
 
-	// Compute comment
-	comment := "This is an apko single-layer image"
+	// Compute comment. The default is deliberately empty: an unannotated
+	// image must not carry tool branding. An explicit title+vendor
+	// annotation pair still produces a descriptive comment.
+	comment := ""
 	if len(layers) > 1 {
 		comment = ""
 	}
@@ -80,9 +82,12 @@ func BuildImageFromLayers(ctx context.Context, baseImage v1.Image, layers []v1.L
 		add := mutate.Addendum{
 			Layer: layer,
 			History: v1.History{
-				Author:    "apko",
+				// Author/CreatedBy are left empty: layer history attribution
+				// is optional and upstream branding does not belong in our
+				// images (containers repository plan.md).
+				Author:    "",
 				Comment:   comment,
-				CreatedBy: "apko",
+				CreatedBy: "",
 				Created:   v1.Time{Time: created}, // TODO: Consider per-layer creation time?
 			},
 		}
@@ -126,7 +131,7 @@ func BuildImageFromLayers(ctx context.Context, baseImage v1.Image, layers []v1.L
 	}
 
 	cfg = cfg.DeepCopy()
-	cfg.Author = "github.com/chainguard-dev/apko"
+	cfg.Author = "Greboid"
 	platform := arch.ToOCIPlatform()
 	cfg.Architecture = platform.Architecture
 	cfg.Variant = platform.Variant
