index d58fa244..14d4ddfe 100644
--- a/pkg/sbom/generator/spdx/spdx.go
+++ b/pkg/sbom/generator/spdx/spdx.go
@@ -38,6 +38,7 @@ import (
 
 	"chainguard.dev/apko/pkg/apk/apk"
 	apkfs "chainguard.dev/apko/pkg/apk/fs"
+	"chainguard.dev/apko/pkg/sbom/canonical"
 	"chainguard.dev/apko/pkg/sbom/generator"
 	"chainguard.dev/apko/pkg/sbom/options"
 )
@@ -112,12 +113,11 @@ func (sx *SPDX) Generate(ctx context.Context, opts *options.Options, path string
 			Created: opts.ImageInfo.SourceDateEpoch.Format(time.RFC3339),
 			Creators: []string{
 				fmt.Sprintf("Tool: apko (%s)", version.GetVersionInfo().GitVersion),
-				"Organization: Chainguard, Inc",
+				"Organization: Greboid",
 			},
 			LicenseListVersion: "3.27",
 		},
 		DataLicense:    "CC0-1.0",
-		Namespace:      "https://spdx.org/spdxdocs/apko/",
 		Packages:       []Package{},
 		Relationships:  []Relationship{},
 		LicensingInfos: []LicensingInfo{},
@@ -195,6 +195,15 @@ func (sx *SPDX) Generate(ctx context.Context, opts *options.Options, path string
 	}
 	doc.Packages = dedupedPackages
 
+	// The document identity: SHA-256 of the RFC 8785 canonical JSON of the
+	// document minus documentNamespace, computed after every other field is
+	// finalised (containers repository plan.md, SBOM namespaces).
+	namespace, err := canonical.StructNamespace(*doc, canonical.NamespaceImages)
+	if err != nil {
+		return fmt.Errorf("computing deterministic SPDX namespace: %w", err)
+	}
+	doc.Namespace = namespace
+
 	if err := renderDoc(doc, path); err != nil {
 		return fmt.Errorf("rendering document: %w", err)
 	}
@@ -766,12 +775,11 @@ func (sx *SPDX) GenerateIndex(opts *options.Options, path string) error {
 			Created: opts.ImageInfo.SourceDateEpoch.Format(time.RFC3339),
 			Creators: []string{
 				fmt.Sprintf("Tool: apko (%s)", version.GetVersionInfo().GitVersion),
-				"Organization: Chainguard, Inc",
+				"Organization: Greboid",
 			},
 			LicenseListVersion: "3.27",
 		},
 		DataLicense:   "CC0-1.0",
-		Namespace:     "https://spdx.org/spdxdocs/apko/",
 		Packages:      []Package{},
 		Relationships: []Relationship{},
 	}
@@ -848,6 +856,14 @@ func (sx *SPDX) GenerateIndex(opts *options.Options, path string) error {
 		addSourcePackage(opts.ImageInfo.VCSUrl, doc, &indexPackage, opts)
 	}
 
+	// Same deterministic identity scheme as per-architecture documents,
+	// under the shared images namespace prefix.
+	namespace, err := canonical.StructNamespace(*doc, canonical.NamespaceImages)
+	if err != nil {
+		return fmt.Errorf("computing deterministic SPDX namespace: %w", err)
+	}
+	doc.Namespace = namespace
+
 	if err := renderDoc(doc, path); err != nil {
 		return fmt.Errorf("rendering document: %w", err)
 	}
