#!/bin/sh
# osimage upgrade wrapper: run bootc upgrade and finalize the staged
# deployment immediately, while the system is fully up.
#
# Why not plain `bootc upgrade`: on this layout (composefs root,
# storage under /sysroot, no fstab entry for /) the shutdown-path
# finalize inside bootc-finalize-staged.service fails ("Inspecting
# filesystem /: No such file or directory"), the staged BLS entries are
# never exchanged, and the next boot silently re-enters the OLD
# deployment. Finalizing explicitly here makes the staged deployment
# boot on the next reboot (see reports/bootc-finalize-staged-shutdown.md).
#
# Usage: osimage-upgrade [bootc upgrade options...]
set -eu

case "${1:-}" in
    -h | --help)
        echo 'Usage: osimage-upgrade [bootc upgrade options...]'
        echo
        echo 'Runs `bootc upgrade`, then finalizes the staged deployment'
        echo '(bootc composefs-finalize-staged) so the next reboot enters it.'
        ;;
    *)
        echo '== bootc upgrade'
        bootc upgrade "$@"

        echo '== finalize staged deployment'
        bootc composefs-finalize-staged

        echo '== staged deployment ready; reboot to enter it'
        ;;
esac
