[Unit]
Description=Materialize the compose-sops age key on tmpfs
Documentation=man:systemd-creds(1)
Requires=systemd-creds.socket
After=systemd-creds.socket local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
RuntimeDirectory=compose-sops
RuntimeDirectoryMode=0700
ExecStartPre=/usr/libexec/osimage-age-key
ExecStart=/usr/bin/systemd-creds decrypt --name=compose-sops-key /var/drover/age-key.cred /run/compose-sops/age-key.txt

[Install]
WantedBy=multi-user.target
