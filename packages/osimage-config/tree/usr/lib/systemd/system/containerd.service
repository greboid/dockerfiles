# containerd container runtime: pulled in by docker.service (Wants=)
# and required by dockerd's --containerd socket; the Alpine containerd
# package ships no systemd unit of its own.
[Unit]
Description=containerd container runtime
Documentation=https://containerd.io
After=network.target local-fs.target

[Service]
# - prefix: overlay may be builtin or already loaded; tolerate failure
ExecStartPre=-/bin/modprobe overlay
ExecStart=/usr/bin/containerd
Type=notify
Delegate=yes
KillMode=process
Restart=always
RestartSec=5
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
