#!/bin/sh
# Set or lock a local account password on a sealed-/etc osimage system.
#
# /etc/shadow is a bind mount of the per-machine copy in
# /var/lib/osimage/etc/shadow (set up by the initramfs, see
# 90osimage-state in osimage-kernel). passwd(1) cannot be used: it
# writes a temporary file next to /etc/shadow and renames it into
# place, which fails on the read-only /etc. This tool edits the /var
# copy in place instead, keeping the inode the bind mount refers to.
#
# Usage: osimage-passwd [-l] [user]   (default user: root)
#   -l  lock the account's password (no password login)
set -eu

SHADOW=/var/lib/osimage/etc/shadow

die() {
    echo "osimage-passwd: $*" >&2
    exit 1
}

lock=0
if [ "${1:-}" = -l ]; then
    lock=1
    shift
fi
user=${1:-root}

[ "$(id -u)" = 0 ] || die "must be run as root"
[ -f "$SHADOW" ] || die "$SHADOW missing (initramfs without the osimage-state module?)"
etc_ino=$(stat -c %d:%i /etc/shadow) && var_ino=$(stat -c %d:%i "$SHADOW") &&
    [ -n "$etc_ino" ] && [ "$etc_ino" = "$var_ino" ] ||
    die "/etc/shadow is not bound to $SHADOW; changes would not take effect"
awk -F: -v u="$user" '$1 == u { found = 1 } END { exit !found }' "$SHADOW" ||
    die "no such user in $SHADOW: $user"

if [ "$lock" = 1 ]; then
    hash='!'
else
    [ -t 0 ] || die "a terminal is required to read the password"
    trap 'stty echo' EXIT INT TERM
    stty -echo
    printf 'New password for %s: ' "$user"
    read -r pw1
    printf '\nRetype password: '
    read -r pw2
    printf '\n'
    stty echo
    trap - EXIT INT TERM
    [ -n "$pw1" ] || die "empty password refused (use -l to lock instead)"
    [ "$pw1" = "$pw2" ] || die "passwords do not match"
    # Password goes through a pipe, never the argument list.
    hash=$(printf '%s\n' "$pw1" | cryptpw -m sha512)
    unset pw1 pw2
    case "$hash" in
        '$6$'*) ;;
        *) die "cryptpw did not produce a SHA-512 hash" ;;
    esac
fi

days=$(($(date +%s) / 86400))
umask 077
tmp="$SHADOW.osimage-passwd.$$"
trap 'rm -f "$tmp"' EXIT INT TERM
awk -F: -v OFS=: -v u="$user" -v h="$hash" -v d="$days" \
    '$1 == u { $2 = h; $3 = d } { print }' "$SHADOW" > "$tmp"
[ "$(wc -l < "$tmp")" = "$(wc -l < "$SHADOW")" ] || die "rewrite produced a different line count; aborting"

cp -p "$SHADOW" "$SHADOW-"
# In place: a rename would leave the bind mount on the old inode.
cat "$tmp" > "$SHADOW"
sync
if [ "$lock" = 1 ]; then
    echo "osimage-passwd: password for $user locked"
else
    echo "osimage-passwd: password for $user updated"
fi
