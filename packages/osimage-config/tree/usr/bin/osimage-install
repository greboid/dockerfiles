#!/bin/sh
# osimage installer: install the published image from the package
# registry onto the target disk with bootc. The live system this runs
# from is the same standard build (the installer media's squashfs); the
# installed system is pulled fresh from the registry, so its digest is
# the registry digest and its upgrade origin is the tag itself.
#
# The default ref is the published image; override both halves with
# OSIMAGE_SOURCE_REF / OSIMAGE_TARGET_REF (they may differ when
# installing one build while tracking another). The osimage container
# repository is anonymously pullable; for private targets, point
# REGISTRY_AUTH_FILE at an authfile first.
#
# Usage: osimage-install <disk-device> [extra bootc install to-disk
# options]
set -eu

disk="${1:?usage: osimage-install <disk-device> [extra bootc options]}"
shift

if [ ! -b "$disk" ]; then
    echo "osimage-install: $disk is not a block device" >&2
    exit 1
fi

default_ref="${OSIMAGE_DEFAULT_REF:-git.mouse-lake.ts.net/osimage/osimage:latest}"
source_ref="${OSIMAGE_SOURCE_REF:-$default_ref}"
target_ref="${OSIMAGE_TARGET_REF:-$default_ref}"
# registry transport unless a scheme is already present (oci:/ for the
# offline install-from-media path, containers-storage:, ...)
case "$source_ref" in
  *://*) ;;
  *) source_ref="docker://$source_ref" ;;
esac

# podman's overlay driver cannot stack on the live system's overlayfs
# root; keep container storage on plain tmpfs instead (discarded with
# the live overlay). The pull lands here, so RAM needs to cover the
# uncompressed image.
if grep -q osimage-store /etc/containers/storage.conf 2>/dev/null; then
    :
else
    mkdir -p /etc/containers /run/osimage-store
    cat > /etc/containers/storage.conf <<EOF
[storage]
driver = "overlay"
runroot = "/run/osimage-store/runroot"
graphroot = "/run/osimage-store/graphroot"
EOF
fi

# Modules bootc's composefs staging needs; udev may not have coldplugged
# them on a live system with no matching root device.
modprobe erofs 2>/dev/null || true
modprobe overlay 2>/dev/null || true

echo "== installing $source_ref onto $disk (origin: $target_ref)"
# The image's packaged kernel arguments live in /usr/lib/bootc/kargs.d
# (init=, consoles). bootc's composefs to-disk flow does not carry them
# into the installed BLS entry on its own - without init= the composefs
# root cannot start systemd - so pass them explicitly. root= is skipped
# because bootc sets the deployment root itself. User-passed options
# come last and win.
kargs_args=
for f in /usr/lib/bootc/kargs.d/*.args; do
    [ -f "$f" ] || continue
    while read -r karg; do
        case "$karg" in
            "" | root=*) continue ;;
        esac
        kargs_args="$kargs_args --karg $karg"
    done < "$f"
done

# Extra options (e.g. --karg) for machine-specific overrides.
# shellcheck disable=SC2086
exec bootc install to-disk \
    --source-imgref "$source_ref" \
    --target-imgref "$target_ref" \
    --filesystem ext4 \
    $kargs_args \
    "$disk" --wipe "$@"
