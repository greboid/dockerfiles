#!/bin/sh
# Roll back to the previous deployment after a failed boot assessment.

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

MNT=/run/osimage-rollback

. /usr/libexec/osimage-boot-common

log() { echo "osimage-rollback-failed-boot: $*"; }

digest=$(booted_composefs_digest)
if [ -z "$digest" ]; then
    log "no composefs.digest on the kernel cmdline; refusing to roll back"
    exit 1
fi

flagdir=/var/lib/osimage/auto-rollback
mkdir -p "$flagdir" || exit 1
for f in "$flagdir"/*; do
    [ -e "$f" ] || continue
    if [ "$(basename "$f")" = "$digest" ] ||
        [ "$(cat "$f" 2>/dev/null)" = "$digest" ]; then
        log "booted deployment $digest is part of a past rollback incident; staying put"
        exit 1
    fi
done

target=
esp=$(booted_esp_device)
if [ -z "$esp" ]; then
    log "cannot identify the booted ESP; staying put"
    exit 1
fi
mkdir -p "$MNT" || exit 1
if mount_esp "$esp" "$MNT"; then
    for f in "$MNT"/loader/entries/*.conf; do
        [ -f "$f" ] || continue
        d=$(entry_composefs_digest "$f")
        [ -n "$d" ] || continue
        if [ "$d" != "$digest" ]; then
            if [ -n "$target" ] && [ "$target" != "$d" ]; then
                log "multiple rollback candidates; refusing to guess"
                umount "$MNT"
                rmdir "$MNT" 2>/dev/null
                exit 1
            fi
            target=$d
        fi
    done
    umount "$MNT"
else
    log "cannot mount the booted ESP $esp; staying put"
    rmdir "$MNT" 2>/dev/null
    exit 1
fi
rmdir "$MNT" 2>/dev/null
if [ -z "$target" ]; then
    log "no rollback target found; staying put"
    exit 1
fi

: >"$flagdir/$digest" || { log "cannot write $flagdir/$digest"; exit 1; }
echo "$target" >"$flagdir/$digest"

if ! bootc rollback; then
    log "bootc rollback failed; staying on the current deployment"
    exit 1
fi

/usr/libexec/osimage-boot-count
log "rolled back from $digest to $target; rebooting"
sync
systemctl reboot --no-wall
