#!/bin/sh
# Deterministic ESP mounting for systemd-bless-boot.

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

MNT=/run/osimage-bless

. /usr/libexec/osimage-boot-common

esp=$(booted_esp_device)
if [ -z "$esp" ]; then
    echo "osimage-bless: cannot identify the booted ESP" >&2
    exit 1
fi

mkdir -p "$MNT" || exit 1
if ! mount_esp "$esp" "$MNT"; then
    echo "osimage-bless: cannot mount the booted ESP $esp" >&2
    rmdir "$MNT" 2>/dev/null
    exit 1
fi

/usr/lib/systemd/systemd-bless-boot --path="$MNT" good
rc=$?
umount "$MNT"
rmdir "$MNT" 2>/dev/null
exit $rc
