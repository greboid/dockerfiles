diff --git a/tests/integration/api_admin_hook_redeliver_test.go b/tests/integration/api_admin_hook_redeliver_test.go
new file mode 100644
index 0000000..c799e14
--- /dev/null
+++ b/tests/integration/api_admin_hook_redeliver_test.go
@@ -0,0 +1,101 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package integration
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+
+	auth_model "forgejo.org/models/auth"
+	webhook_model "forgejo.org/models/webhook"
+	api "forgejo.org/modules/structs"
+	"forgejo.org/modules/timeutil"
+	webhook_module "forgejo.org/modules/webhook"
+	"forgejo.org/tests"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAPIAdminRedeliverHook(t *testing.T) {
+	defer tests.PrepareTestEnv(t)()
+
+	var mu sync.Mutex
+	var received []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		received = append(received, r.Header.Get("X-Forgejo-Event"))
+		mu.Unlock()
+	}))
+	defer srv.Close()
+
+	hook := &webhook_model.Webhook{
+		URL:             srv.URL,
+		HTTPMethod:      http.MethodPost,
+		Type:            webhook_module.FORGEJO,
+		ContentType:     webhook_model.ContentTypeJSON,
+		IsSystemWebhook: true,
+		IsActive:        true,
+		HookEvent:       &webhook_module.HookEvent{SendEverything: true},
+	}
+	require.NoError(t, webhook_model.CreateWebhook(t.Context(), hook, ""))
+
+	cutoff := time.Now().Add(-time.Hour)
+	addTask := func(event webhook_module.HookEventType, delivered time.Time, succeeded bool) *webhook_model.HookTask {
+		task, err := webhook_model.CreateHookTask(t.Context(), &webhook_model.HookTask{
+			HookID:         hook.ID,
+			PayloadContent: `{"ref":"refs/heads/main"}`,
+			PayloadVersion: 2,
+			EventType:      event,
+			IsDelivered:    true,
+			IsSucceed:      succeeded,
+			Delivered:      timeutil.TimeStampNano(delivered.UnixNano()),
+		})
+		require.NoError(t, err)
+		return task
+	}
+	addTask(webhook_module.HookEventPush, cutoff.Add(-time.Minute), false)
+	addTask(webhook_module.HookEventPush, cutoff.Add(time.Minute), true)
+	failed := addTask(webhook_module.HookEventPullRequest, cutoff.Add(time.Minute), false)
+
+	adminToken := getUserToken(t, "user1", auth_model.AccessTokenScopeWriteAdmin)
+	url := fmt.Sprintf("/api/v1/admin/hooks/%d/redeliver", hook.ID)
+
+	t.Run("Redeliver", func(t *testing.T) {
+		req := NewRequestWithJSON(t, "POST", url, &api.RedeliverHookOption{Since: cutoff}).AddTokenAuth(adminToken)
+		resp := MakeRequest(t, req, http.StatusOK)
+		var got []*api.HookRedelivery
+		DecodeJSON(t, resp, &got)
+		require.Len(t, got, 1)
+		assert.Equal(t, failed.UUID, got[0].ReplayOf)
+		assert.Equal(t, "pull_request", got[0].Event)
+		assert.NotEqual(t, failed.UUID, got[0].UUID)
+
+		assert.Eventually(t, func() bool {
+			mu.Lock()
+			defer mu.Unlock()
+			return len(received) == 1 && received[0] == "pull_request"
+		}, 10*time.Second, 50*time.Millisecond)
+	})
+
+	t.Run("Missing since", func(t *testing.T) {
+		req := NewRequestWithJSON(t, "POST", url, &api.RedeliverHookOption{}).AddTokenAuth(adminToken)
+		MakeRequest(t, req, http.StatusUnprocessableEntity)
+	})
+
+	t.Run("Unknown hook", func(t *testing.T) {
+		req := NewRequestWithJSON(t, "POST", "/api/v1/admin/hooks/999999/redeliver", &api.RedeliverHookOption{Since: cutoff}).AddTokenAuth(adminToken)
+		MakeRequest(t, req, http.StatusNotFound)
+	})
+
+	t.Run("Not admin", func(t *testing.T) {
+		token := getUserToken(t, "user2", auth_model.AccessTokenScopeWriteAdmin)
+		req := NewRequestWithJSON(t, "POST", url, &api.RedeliverHookOption{Since: cutoff}).AddTokenAuth(token)
+		MakeRequest(t, req, http.StatusForbidden)
+	})
+}
