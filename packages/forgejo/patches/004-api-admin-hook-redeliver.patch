+// RedeliverHookOption selects the failed deliveries of a webhook to redeliver
+type RedeliverHookOption struct {
+	// Redeliver failed deliveries attempted at or after this time
+	// required: true
+	// swagger:strfmt date-time
+	Since time.Time `json:"since"`
+}
+
+// HookRedelivery is a delivery queued by replaying a failed one
+type HookRedelivery struct {
+	// UUID of the new delivery
+	UUID string `json:"uuid"`
+	// UUID of the failed delivery it replays
+	ReplayOf string `json:"replay_of"`
+	Event    string `json:"event"`
+}
