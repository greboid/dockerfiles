+// FindFailedHookTasksSince returns the hook tasks of hookID whose delivery was attempted at or after since and failed, oldest first
+func FindFailedHookTasksSince(ctx context.Context, hookID int64, since timeutil.TimeStampNano) ([]*HookTask, error) {
+	tasks := make([]*HookTask, 0, 10)
+	return tasks, db.GetEngine(ctx).
+		Where("hook_id = ?", hookID).
+		And("is_delivered = ?", true).
+		And("is_succeed = ?", false).
+		And("delivered >= ?", since).
+		Asc("id").
+		Find(&tasks)
+}
