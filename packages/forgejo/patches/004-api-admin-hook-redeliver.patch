+// RedeliverHook replays the failed deliveries of a system webhook
+func RedeliverHook(ctx *context.APIContext) {
+	// swagger:operation POST /admin/hooks/{id}/redeliver admin adminRedeliverHook
+	// ---
+	// summary: Redeliver the failed deliveries of a hook attempted since a given time
+	// description: Each failed delivery still kept in the delivery history is queued again as a new delivery, oldest first. A failed delivery is replayed again by every call whose time covers it.
+	// consumes:
+	// - application/json
+	// produces:
+	// - application/json
+	// parameters:
+	// - name: id
+	//   in: path
+	//   description: id of the hook
+	//   type: integer
+	//   format: int64
+	//   required: true
+	// - name: body
+	//   in: body
+	//   required: true
+	//   schema:
+	//     "$ref": "#/definitions/RedeliverHookOption"
+	// responses:
+	//   "200":
+	//     "$ref": "#/responses/HookRedeliveryList"
+	//   "404":
+	//     "$ref": "#/responses/notFound"
+	//   "422":
+	//     "$ref": "#/responses/validationError"
+
+	form := web.GetForm(ctx).(*api.RedeliverHookOption)
+	if form.Since.IsZero() {
+		ctx.Error(http.StatusUnprocessableEntity, "", "since is required")
+		return
+	}
+
+	hook, err := webhook.GetSystemOrDefaultWebhook(ctx, ctx.ParamsInt64(":id"))
+	if err != nil {
+		if errors.Is(err, util.ErrNotExist) {
+			ctx.NotFound()
+		} else {
+			ctx.Error(http.StatusInternalServerError, "GetSystemOrDefaultWebhook", err)
+		}
+		return
+	}
+
+	replays, originals, err := webhook_service.RedeliverFailedHookTasks(ctx, hook, form.Since)
+	if err != nil {
+		ctx.Error(http.StatusInternalServerError, "RedeliverFailedHookTasks", err)
+		return
+	}
+	out := make([]*api.HookRedelivery, len(replays))
+	for i, t := range replays {
+		out[i] = &api.HookRedelivery{UUID: t.UUID, ReplayOf: originals[i], Event: string(t.EventType)}
+	}
+	ctx.JSON(http.StatusOK, out)
+}
