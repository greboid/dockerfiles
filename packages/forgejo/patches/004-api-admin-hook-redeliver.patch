+// RedeliverFailedHookTasks replays every failed delivery of w attempted at or after since.
+// It returns the new tasks paired by position with the UUIDs of the deliveries they replay.
+func RedeliverFailedHookTasks(ctx context.Context, w *webhook_model.Webhook, since time.Time) (replays []*webhook_model.HookTask, originals []string, err error) {
+	failed, err := webhook_model.FindFailedHookTasksSince(ctx, w.ID, timeutil.TimeStampNano(since.UnixNano()))
+	if err != nil {
+		return nil, nil, err
+	}
+	for _, t := range failed {
+		replay, err := webhook_model.ReplayHookTask(ctx, w.ID, t.UUID)
+		if err != nil {
+			return replays, originals, err
+		}
+		replays = append(replays, replay)
+		originals = append(originals, t.UUID)
+		if err := enqueueHookTask(replay.ID); err != nil {
+			return replays, originals, err
+		}
+	}
+	return replays, originals, nil
+}
