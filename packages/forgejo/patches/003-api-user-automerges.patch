 	return err
 }
+
+// FindScheduledMergesByDoer returns the auto merges scheduled by doerID, oldest first, with the total count
+func FindScheduledMergesByDoer(ctx context.Context, doerID int64, opts db.ListOptions) ([]*AutoMerge, int64, error) {
+	sess := db.GetEngine(ctx).Where("doer_id = ?", doerID).Asc("id")
+	if !opts.IsListAll() {
+		sess = db.SetSessionPagination(sess, &opts)
+	}
+	merges := make([]*AutoMerge, 0, 10)
+	total, err := sess.FindAndCount(&merges)
+	return merges, total, err
+}
