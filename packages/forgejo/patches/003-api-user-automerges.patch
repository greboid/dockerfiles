+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package user
+
+import (
+	"net/http"
+
+	issues_model "forgejo.org/models/issues"
+	access_model "forgejo.org/models/perm/access"
+	pull_model "forgejo.org/models/pull"
+	"forgejo.org/models/unit"
+	api "forgejo.org/modules/structs"
+	"forgejo.org/routers/api/v1/utils"
+	"forgejo.org/services/context"
+)
+
+// ListMyAutoMerges lists the auto merges scheduled by the authenticated user
+func ListMyAutoMerges(ctx *context.APIContext) {
+	// swagger:operation GET /user/automerges user userListAutoMerges
+	// ---
+	// summary: List the pull requests the authenticated user has scheduled to merge when checks succeed
+	// description: Bookings in repositories the user can no longer read are omitted from the page, so a page may be shorter than the limit.
+	// produces:
+	// - application/json
+	// parameters:
+	// - name: page
+	//   in: query
+	//   description: page number of results to return (1-based)
+	//   type: integer
+	// - name: limit
+	//   in: query
+	//   description: page size of results
+	//   type: integer
+	// responses:
+	//   "200":
+	//     "$ref": "#/responses/ScheduledAutoMergeList"
+	//   "401":
+	//     "$ref": "#/responses/unauthorized"
+	//   "403":
+	//     "$ref": "#/responses/forbidden"
+
+	merges, total, err := pull_model.FindScheduledMergesByDoer(ctx, ctx.Doer().ID, utils.GetListOptions(ctx))
+	if err != nil {
+		ctx.InternalServerError(err)
+		return
+	}
+
+	out := make([]*api.ScheduledAutoMerge, 0, len(merges))
+	for _, am := range merges {
+		pr, err := issues_model.GetPullRequestByID(ctx, am.PullID)
+		if issues_model.IsErrPullRequestNotExist(err) {
+			continue
+		}
+		if err != nil {
+			ctx.InternalServerError(err)
+			return
+		}
+		if err := pr.LoadIssue(ctx); err != nil {
+			ctx.InternalServerError(err)
+			return
+		}
+		if err := pr.LoadBaseRepo(ctx); err != nil {
+			ctx.InternalServerError(err)
+			return
+		}
+		repo := pr.BaseRepo
+		pr.Issue.Repo = repo
+		if repo.IsPrivate && ctx.PublicOnly() {
+			continue
+		}
+		perm, err := access_model.GetUserRepoPermission(ctx, repo, ctx.Doer())
+		if err != nil {
+			ctx.InternalServerError(err)
+			return
+		}
+		if !perm.CanRead(unit.TypePullRequests) {
+			continue
+		}
+		out = append(out, &api.ScheduledAutoMerge{
+			Repository: &api.RepositoryMeta{
+				ID:       repo.ID,
+				Name:     repo.Name,
+				Owner:    repo.OwnerName,
+				FullName: repo.FullName(),
+			},
+			Index:                  pr.Index,
+			PullRequestURL:         pr.Issue.HTMLURL(),
+			MergeStyle:             string(am.MergeStyle),
+			DeleteBranchAfterMerge: am.DeleteBranchAfterMerge,
+			Created:                am.CreatedUnix.AsTime(),
+		})
+	}
+
+	ctx.SetTotalCountHeader(total)
+	ctx.JSON(http.StatusOK, out)
+}
