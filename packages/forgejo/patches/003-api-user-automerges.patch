@@ -0,0 +1,57 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package integration
+
+import (
+	"net/http"
+	"testing"
+
+	auth_model "forgejo.org/models/auth"
+	issues_model "forgejo.org/models/issues"
+	pull_model "forgejo.org/models/pull"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unittest"
+	user_model "forgejo.org/models/user"
+	api "forgejo.org/modules/structs"
+	"forgejo.org/tests"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAPIListMyAutoMerges(t *testing.T) {
+	defer tests.PrepareTestEnv(t)()
+
+	user2 := unittest.AssertExistsAndLoadBean(t, &user_model.User{ID: 2})
+	pr := unittest.AssertExistsAndLoadBean(t, &issues_model.PullRequest{ID: 2})
+	repo := unittest.AssertExistsAndLoadBean(t, &repo_model.Repository{ID: pr.BaseRepoID})
+	require.NoError(t, pull_model.ScheduleAutoMerge(t.Context(), user2, pr.ID, repo_model.MergeStyleSquash, "msg", true))
+
+	list := func(t *testing.T, username string) []*api.ScheduledAutoMerge {
+		t.Helper()
+		token := getUserToken(t, username, auth_model.AccessTokenScopeReadRepository, auth_model.AccessTokenScopeReadUser)
+		resp := MakeRequest(t, NewRequest(t, "GET", "/api/v1/user/automerges").AddTokenAuth(token), http.StatusOK)
+		var out []*api.ScheduledAutoMerge
+		DecodeJSON(t, resp, &out)
+		return out
+	}
+
+	t.Run("Booker", func(t *testing.T) {
+		got := list(t, user2.Name)
+		require.Len(t, got, 1)
+		assert.Equal(t, repo.FullName(), got[0].Repository.FullName)
+		assert.Equal(t, pr.Index, got[0].Index)
+		assert.Equal(t, "squash", got[0].MergeStyle)
+		assert.True(t, got[0].DeleteBranchAfterMerge)
+	})
+
+	t.Run("Other user", func(t *testing.T) {
+		assert.Empty(t, list(t, "user4"))
+	})
+
+	t.Run("Missing repository scope", func(t *testing.T) {
+		token := getUserToken(t, user2.Name, auth_model.AccessTokenScopeReadUser)
+		MakeRequest(t, NewRequest(t, "GET", "/api/v1/user/automerges").AddTokenAuth(token), http.StatusForbidden)
+	})
+}
