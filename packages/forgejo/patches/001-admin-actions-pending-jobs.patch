diff --git a/routers/web/admin/runners.go b/routers/web/admin/runners.go
index c6451a9..72ff1c2 100644
--- a/routers/web/admin/runners.go
+++ b/routers/web/admin/runners.go
@@ -4,10 +4,47 @@
 package admin
 
 import (
+	"net/http"
+
+	actions_model "forgejo.org/models/actions"
+	"forgejo.org/models/db"
+	"forgejo.org/modules/base"
 	"forgejo.org/modules/setting"
 	"forgejo.org/services/context"
 )
 
+const tplActions base.TplName = "admin/actions"
+
+// ActionsJobs lists every Actions job on the instance that has not reached a final status.
+func ActionsJobs(ctx *context.Context) {
+	opts := actions_model.FindRunJobOptions{
+		ListOptions: db.ListOptions{
+			Page:     max(ctx.FormInt("page"), 1),
+			PageSize: 30,
+		},
+		Statuses: actions_model.PendingStatuses(),
+	}
+
+	jobs, count, err := db.FindAndCount[actions_model.ActionRunJob](ctx, opts)
+	if err != nil {
+		ctx.ServerError("FindAndCount", err)
+		return
+	}
+	if err := actions_model.ActionJobList(jobs).LoadAttributes(ctx, true); err != nil {
+		ctx.ServerError("LoadAttributes", err)
+		return
+	}
+
+	ctx.Data["Title"] = ctx.Tr("actions.jobs")
+	ctx.Data["PageType"] = "jobs"
+	ctx.Data["PageIsAdminActionsJobs"] = true
+	ctx.Data["Jobs"] = jobs
+	ctx.Data["Total"] = count
+	ctx.Data["Page"] = context.NewPagination(int(count), opts.PageSize, opts.Page, 5)
+
+	ctx.HTML(http.StatusOK, tplActions)
+}
+
 func RedirectToDefaultSetting(ctx *context.Context) {
 	ctx.Redirect(setting.AppSubURL + "/admin/actions/runners")
 }
